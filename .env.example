# Backend Configuration
API_PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Database
DB_PATH=./data/mygunj.db

# WebSocket
WS_PORT=3000

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# OTP/SMS (Provider Integration - Development mode if not configured)
OTP_PROVIDER=development
# OTP_PROVIDER=twilio (when configured)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:19006

# Client Configuration (Frontend)
REACT_APP_API_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3000
